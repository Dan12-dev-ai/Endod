# Copy to deploy/.env on the server (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 48

# --- Mode -------------------------------------------------------------------
# staging: SMS codes are written to the API log instead of being sent, so the
#   app works before the SMS Ethiopia account is set up.
# production: requires SMSETHIOPIA_API_KEY; the API refuses to pretend it
#   sent a message it could not send.
ENVIRONMENT=staging

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=
ADMIN_API_KEY=
REALTIME_TOKEN_SECRET=
# From the Cloudflare tunnel (Zero Trust > Networks > Tunnels > the tunnel).
TUNNEL_TOKEN=

CORS_ORIGINS=https://endod-health.com
PUBLIC_WEB_URL=https://endod-health.com

# --- SMS (SMS Ethiopia) -------------------------------------------------------
# Verification codes and appointment reminders are sent only by SMS.
# Required in production.
SMSETHIOPIA_API_KEY=

# --- Reminders --------------------------------------------------------------
# SMS only: there is no mail server, so no email reminders are queued.
REMINDER_CHANNELS=sms
# Turn on together with production + SMSETHIOPIA_API_KEY, so reminders go out.
NOTIFICATION_WORKER_ENABLED=false

# --- AI ---------------------------------------------------------------------
# The patient app has no AI agent; keep the built-in rules and no model key.
AI_PROVIDER_MODE=offline
