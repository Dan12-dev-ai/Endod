# Copy to deploy/.env on the server (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 48

# --- Mode -------------------------------------------------------------------
# staging: SMS codes and emails are written to the API log instead of being
#   sent, so the app works before the SMS/email accounts exist.
# production: requires SMSETHIOPIA_API_KEY (and SMTP for email reminders);
#   the API refuses to pretend it sent a message it could not send.
ENVIRONMENT=staging

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=
ADMIN_API_KEY=
REALTIME_TOKEN_SECRET=
# From the Cloudflare tunnel (Zero Trust > Networks > Tunnels > the tunnel).
TUNNEL_TOKEN=

CORS_ORIGINS=https://endod-health.com
PUBLIC_WEB_URL=https://endod-health.com

# --- Reminders --------------------------------------------------------------
# Leave off until SMS/email are configured, or reminders are "sent" to the log.
NOTIFICATION_WORKER_ENABLED=false

# --- Services (optional until production) -----------------------------------
# SMSETHIOPIA_API_KEY=
# AI_PROVIDER_MODE=offline   # or set GEMINI_API_KEY for the live model
# GEMINI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@endod-health.com
