# Copy to deploy/.env on the server (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 48

# --- Mode -------------------------------------------------------------------
# production: requires SMSETHIOPIA_API_KEY; the API refuses to pretend it
#   sent a message it could not send.
# staging: only before the SMS Ethiopia account is set up -- SMS codes are
#   written to the API log instead of being sent.
# Both need the master key file (below); only development or test may run
# without one, and never with real data.
ENVIRONMENT=production

# --- Encryption of health data ------------------------------------------------
# Not a variable here: the master key is a FILE, /opt/endod/deploy/keys/master.key
# (32 random bytes: openssl rand -out master.key 32), which docker-compose.yml
# mounts read-only into backend, internal-api and events-worker and names with
# PLATFORM_MASTER_KEY_FILE. Keep an OFFLINE backup of it: without it the
# health data cannot be read, from the database or from any backup.
# See README.md, "Encryption of health data".

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=
ADMIN_API_KEY=
REALTIME_TOKEN_SECRET=
# Signs the QR code on every Digital Health Card. Set it once and keep it:
# changing it makes every printed card fail verification. (Unset, the
# session secret above is used, so rotating that would void the cards.)
CARD_SIGNING_SECRET=
# From the Cloudflare tunnel (Zero Trust > Networks > Tunnels > the tunnel).
TUNNEL_TOKEN=

CORS_ORIGINS=https://endod-health.com
PUBLIC_WEB_URL=https://endod-health.com

# --- SMS (SMS Ethiopia) -------------------------------------------------------
# Verification codes and appointment reminders are sent only by SMS.
# Required in production.
SMSETHIOPIA_API_KEY=

# --- Reminders --------------------------------------------------------------
# SMS only: there is no mail server, so no email reminders are queued.
REMINDER_CHANNELS=sms
# Turn on together with production + SMSETHIOPIA_API_KEY, so reminders go out.
NOTIFICATION_WORKER_ENABLED=false

# --- Events with the hospital service (Redis with Sentinel) ------------------
REDIS_PASSWORD=
# Optional: a password on the Sentinels themselves.
REDIS_SENTINEL_PASSWORD=

# --- Patient history from the hospital service (docs/history-events.md) --------
# The hospital API on the private endod-bus network (never public): record
# files are downloaded from it.
HOSPITAL_API_URL=http://endod-hospital-api:8000
# Shared with the hospital service (the same value as its PLATFORM_ADMIN_KEY):
# sent to its /platform API, and required on internal-api's /internal endpoints.
# Unset, both are refused. Generate with: openssl rand -base64 48
PLATFORM_ADMIN_KEY=
# Set by docker-compose.yml to the records volume; change it only outside Docker.
# RECORD_FILES_DIR=/data/records

# --- Prescriptions at pharmacies (docs/pharmacy.md) ------------------------------
# Shared with the pharmacy site's server (the same value as its
# PHARMACY_API_KEY): required as X-Pharmacy-Key on internal-api's /pharmacy
# endpoints. Unset, they refuse every request. Generate with: openssl rand -base64 48
PHARMACY_API_KEY=
# Signs the QR code on every prescription (not the card key). Set it once and
# keep it: changing it stops every QR already issued from scanning (the
# 6-digit code keeps working). Generate with: openssl rand -base64 48
RX_SIGNING_KEY=

# --- Payments (Chapa) ----------------------------------------------------------
# From the Chapa dashboard (test keys: CHASECK_TEST-...). Patients pay for each
# booking through Chapa and refunds use Chapa's refund API with the same key
# (docs/payments.md). Without a key, paid bookings answer "not set up yet".
CHAPA_SECRET_KEY=
# Chapa > Settings > Webhooks: the secret hash. Webhook URL:
# https://endod-health.com/api/payments/chapa/webhook
CHAPA_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://endod-health.com
# Endod's fee on each payment, in santim (500 = 5 birr), plus a share in
# hundredths of a percent (100 = 1%).
SERVICE_FEE_FLAT_SANTIM=500
SERVICE_FEE_PERCENT_BP=0

# --- Video visits (self-hosted Jitsi, deploy/jitsi) ----------------------------
JITSI_DOMAIN=meet.endod-health.com
JITSI_APP_ID=endod
# The same secret as JWT_APP_SECRET in deploy/jitsi/.env and the hospital
# service's HOSPITAL_JITSI_APP_SECRET.
JITSI_APP_SECRET=

# --- AI ---------------------------------------------------------------------
# The patient app has no AI agent; keep the built-in rules and no model key.
AI_PROVIDER_MODE=offline
