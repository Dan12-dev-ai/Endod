# Copy to deploy/jitsi/.env on the server (never commit it).
# Secrets: openssl rand -hex 32
JWT_APP_ID=endod
# Must equal JITSI_APP_SECRET in deploy/.env and HOSPITAL_JITSI_APP_SECRET.
JWT_APP_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
# The server's public IPv4 address (calls connect to it on UDP 10000).
JVB_ADVERTISE_IPS=
