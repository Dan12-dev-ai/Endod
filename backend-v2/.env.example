# =============================================================================
# DEDAN Health — example environment file
#
#   cp .env.example .env
#
# NEVER commit a populated .env. Only `.env.example` (this file) is tracked.
# The default configuration runs in OFFLINE / mock mode, so the system is fully
# usable with $0 cost and no provider credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# `ENVIRONMENT` (development | staging | production). In `production` the API
# disables the interactive docs (/docs, /redoc, /openapi.json) and enables
# TrustedHostMiddleware.
ENVIRONMENT=development
DEBUG=true

# -----------------------------------------------------------------------------
# Server binding
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
# The Vite dev server port (frontend-only) is configured in
# `web-portal/.env.local` via VITE_API_URL / VITE_PORT, not here.

# Comma-separated list of browser origins allowed to call the API.
#
# SECURITY: `*` is refused when ENVIRONMENT=production. Combined with
# `allow_credentials=True`, a wildcard makes the server reflect any caller's
# Origin with credentials enabled, which lets any website read these responses
# for a logged-in user. Always list exact origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Security — REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------
# The API refuses to start in production without a key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Used for: the X-API-Key / Bearer credential on protected routes, admin-only
# operations (model retraining, platform stats) and the session cookie signature.
ADMIN_API_KEY=

# Signs the patient session tokens handed out by /auth/register, /auth/login
# and the phone sign-in.
# Falls back to ADMIN_API_KEY when unset, so set it separately only if the two
# must differ.
#
# REQUIRED for the portal to work. Without it, signup and login fail with
# "No token signing secret configured": the signer refuses to mint rather than
# fall back to a hard-coded key, and the app raises instead of running insecure.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REALTIME_TOKEN_SECRET=

# --- Portal accounts ---------------------------------------------------------
# Password storage for /auth/register and /auth/login. Standard library only
# (PBKDF2-HMAC-SHA256); no bcrypt/argon2 dependency is added.
#
#   PASSWORD_ITERATIONS  PBKDF2 work factor. Higher is slower to brute-force and
#                        slower to log in. Existing accounts are re-hashed on
#                        their next successful login when this is raised.
#   PASSWORD_LOCKOUT_ATTEMPTS  Consecutive failures before a cooldown starts.
#   PASSWORD_LOCKOUT_MINUTES    How long that cooldown lasts.
#   PORTAL_TOKEN_TTL     Portal session lifetime in seconds (default 12h). Must
#                        comfortably exceed a consultation, or a patient gets
#                        signed out mid-visit.
# PASSWORD_ITERATIONS=200000
# PASSWORD_LOCKOUT_ATTEMPTS=8
# PASSWORD_LOCKOUT_MINUTES=15
# PORTAL_TOKEN_TTL=43200

# Signs the session cookie (main_clinical). Falls back to ADMIN_API_KEY. In
# development a random per-process secret is generated when neither is set, so no
# deployment ever signs cookies with a known constant.
# SESSION_SECRET=

# Set to true ONLY when the app genuinely sits behind a reverse proxy/load
# balancer you control. While false (the safe default) X-Forwarded-For is
# ignored for rate limiting, because an untrusted client can set that header to
# any value and would otherwise mint unlimited identities to bypass the limit.
# TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# PHI retention limits (in-memory stores)
# -----------------------------------------------------------------------------
# Uploaded images are held in memory only, bounded and expiring, so they are
# neither a memory-exhaustion vector nor an indefinite data store.
IMAGE_TTL_SECONDS=3600
IMAGE_STORE_MAX_ITEMS=500
V1_SESSION_TTL_SECONDS=7200
V1_SESSION_MAX_ITEMS=1000
V1_TRIAGE_TTL_SECONDS=86400
V1_TRIAGE_MAX_ITEMS=5000

# -----------------------------------------------------------------------------
# AI provider mode
# -----------------------------------------------------------------------------
# offline | mock | local | rules  -> deterministic, no network, no cost.
# Any other value allows live provider calls when a usable credential exists.
AI_PROVIDER_MODE=offline

# Set to 1 to force live provider calls even if credentials look like
# placeholders. Leave unset during development.
# AI_FORCE_LIVE=

# Per-capability provider routing (only used when NOT in offline mode).
# Default is Gemini for every capability: it is the credential this project
# provisions. Set AI_TEXT_PROVIDER=openai only if you have configured an
# OpenAI key, otherwise text analysis fails with a 401.
# AI_TEXT_PROVIDER=gemini
# AI_VISION_PROVIDER=gemini
# AI_MULTIMODAL_PROVIDER=gemini

# Per-capability MODEL overrides (optional). Text triage is short-form and
# latency-sensitive, so routing it to a Flash-class model is a large win;
# image analysis uses the stronger model where quality matters most.
# See providers/gemini_models.py for the full registry and fallback chains.
AI_TEXT_MODEL=gemini-flash-lite-latest
AI_VISION_MODEL=gemini-3.5-flash
AI_MULTIMODAL_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# Provider credentials — OPTIONAL
# -----------------------------------------------------------------------------
# Leave BOTH blank to stay in offline mode. Supplying one enables live calls
# for that provider and may incur usage charges. Do not commit real keys.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

GEMINI_MODEL=gemini-flash-latest

# Optional Gemini prices (USD per 1M tokens) for the audit log's cost field.
# Unset means the cost is logged as unknown, never as zero.
# GEMINI_PRICE_INPUT_PER_1M=
# GEMINI_PRICE_OUTPUT_PER_1M=
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Generation parameters (used for live providers).
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Image upload limits
# -----------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
# Comma-separated MIME types accepted by the image validation pipeline.
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic
IMAGE_STORAGE_PATH=/tmp/dedan_images
IMAGE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# PostgreSQL in production; SQLite is the local/test default. In production the
# app refuses to start without this (no silent SQLite fallback). Read from the
# environment or this file. The engine is created lazily on first use.
# DEDAN_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dedan
DEDAN_DATABASE_URL=sqlite:///./dedan_platform.db

# PostgreSQL connection pool. Ignored by SQLite, which has no server-side pool.
# DEDAN_DB_POOL_SIZE=10
# DEDAN_DB_MAX_OVERFLOW=20
# DEDAN_DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Email delivery (required for real reminders)
# -----------------------------------------------------------------------------
# With SMTP_HOST unset, development falls back to the console transport, which
# LOGS messages instead of sending them. In production the worker refuses to
# "send" that way: reminders stay queued and notification_delivery_blocked is
# logged on every pass until SMTP_HOST is set.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@dedanhealth.org
# SMTP_TLS=true                      # STARTTLS; set false only for a local relay
# SMTP_TIMEOUT_SECONDS=20            # bounds a hung mail server
# Link in reminder emails = PUBLIC_WEB_URL + PORTAL_APPOINTMENTS_PATH. Without
# PUBLIC_WEB_URL the email has no link rather than a broken one.
# PUBLIC_WEB_URL=https://app.dedanhealth.org
# PORTAL_APPOINTMENTS_PATH=/interview

# -----------------------------------------------------------------------------
# SMS (phone sign-up codes) -- SMS Ethiopia
# -----------------------------------------------------------------------------
# REQUIRED in production for phone sign-up. Without a key, development logs the
# code (look for sms_console_delivery) and production refuses with a 503
# rather than pretending the SMS was sent.
# Every failed send is logged as sms_send_rejected with the provider's status
# and reply, which is where to look when "the code never arrives".
# SMSETHIOPIA_API_KEY=
# SMSETHIOPIA_API_URL=https://smsethiopia.com/api/sms/send
# SMS_BRAND_NAME=Endod Health       # shown in the SMS text
# OTP_TTL_MINUTES=5                 # code lifetime
# OTP_MAX_ATTEMPTS=5                # wrong guesses before the code is void
# OTP_RESEND_SECONDS=60             # cooldown between codes to one phone
# OTP_MAX_PER_PHONE_PER_HOUR=5
# OTP_MAX_PER_CLIENT_PER_HOUR=30      # per caller address; behind a proxy set
#                                    # TRUST_PROXY_HEADERS=true, or every patient
#                                    # shares one address and this one limit
# PHONE_VERIFICATION_TTL=900        # seconds to set the password after verifying

# -----------------------------------------------------------------------------
# Notification worker
# -----------------------------------------------------------------------------
# Appointment reminders are queued in the `notifications` table by the API and
# delivered by this worker. With it disabled, reminders accumulate and are NEVER
# delivered -- that was the previous behaviour, and the deployed database held
# 52 queued reminders and 0 sent.
#
# `true` runs the loop inside the API process. That is correct for a single
# replica: job claiming is an atomic conditional UPDATE, so several workers
# cannot take the same job. For a multi-replica deployment, enable it on exactly
# one process, or leave it off and run `python -m dedan_platform.worker_main`
# as its own supervised process instead.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_INTERVAL_SECONDS=30
NOTIFICATION_WORKER_BATCH_SIZE=50
# On worker start, repair appointments whose reminders are missing and clear
# reminders left on cancelled/completed appointments.
NOTIFICATION_RECONCILE_ON_START=true

# Retry policy. Failures back off exponentially and stop after MAX_ATTEMPTS, so
# a mail outage cannot become an unbounded retry storm.
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BASE_BACKOFF=60
# A job left in PROCESSING longer than this was orphaned by a crashed worker
# and is returned to the queue.
NOTIFICATION_STALE_SECONDS=300

# Reminder offsets (seconds before the appointment) when neither the
# appointment nor the user's preferences specify any. 604800=7d, 86400=24h,
# 3600=1h. Patients can override these in the portal.
# REMINDER_DEFAULT_OFFSETS=604800,86400,3600

# What to do with a reminder whose window closed before it was queued -- a
# booking made less than 24h (or less than 1h) before the appointment.
#   skip     -- do not queue it; the absence is recorded as a SKIPPED row.
#               Default, and the safer behaviour: a reminder that fires on
#               arrival arrives after the appointment it is reminding about.
#   compress -- queue one reminder to fire on the next worker pass, for clinics
#               that want late bookers contacted anyway.
REMINDER_LATE_BOOKING_POLICY=skip
REMINDER_COMPRESS_DELAY_SECONDS=300

# -----------------------------------------------------------------------------
# Rate limiting (per client IP, in-process)
# -----------------------------------------------------------------------------
# Per-IP request budget. 30/minute was below what a single consultation
# costs (the dashboard alone issues four calls), so a patient could exhaust the
# allowance and be locked out of their own record mid-session. The static portal
# assets are exempt from this limit entirely (RateLimitMiddleware.STATIC_SUFFIXES).
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Name of the header used for privileged operations.
API_KEY_HEADER=X-API-Key
# Shared secret for session cookies. REQUIRED in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# External services (optional, not required for local development)
# -----------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=
# Default country used for pharmacy/regulatory guidance.
COUNTRY_CODE=ET


# Signer for patient session tokens. Falls back to ADMIN_API_KEY.
# REALTIME_TOKEN_SECRET=

