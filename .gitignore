# ---------------------------------------------------------------------------
# DEDAN Health — environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy.ini

# ---------------------------------------------------------------------------
# Node / Node.js build artifacts
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
# ...except the portal's Tailwind build config.
#
# `web-portal/build/` holds `tailwind.config.js`, the single source of truth for
# the design tokens that generate the *committed* `assets/tailwind.css`. Under
# the blanket rule it was untracked, so a fresh clone could serve the stylesheet
# but had no way to rebuild or change it. Only the config and its manifest are
# wanted; `node_modules/` stays ignored by the rule above.
!web-portal/build/
web-portal/build/*
!web-portal/build/tailwind.config.js
!web-portal/build/package.json
!web-portal/build/package-lock.json
!web-portal/build/safelist.txt
!web-portal/build/normalize_shell.py
.vite/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Logs & runtime artifacts
# ---------------------------------------------------------------------------
*.log
logs/
/tmp/

# ---------------------------------------------------------------------------
# Local databases & uploaded media (may contain health data)
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
# SQLite WAL sidecars — same database content, same sensitivity.
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# ---------------------------------------------------------------------------
# Runtime state created by scripts/ (PID tracking)
# ---------------------------------------------------------------------------
*.pid
.run/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Stray editor backups
# ---------------------------------------------------------------------------
*.bak
*.orig
# `*.bak` alone does not cover these: the suffix rule matches the end of the
# name, so `index.html.bak.incomplete` was still trackable and three of them
# were staged for commit. Backups have no business in the repository at all.
*.bak.*
*.incomplete
*_incomplete.*
# Made on the server by sync.sh: origin certificate and the edge key.
deploy/shared-nginx/tls/
