# Copy to .env.local and adjust.

# Where the DEDAN backend (backend-v2) runs. Only the Next.js server calls it;
# the browser talks to /api/... on this app, never to the backend directly.
DEDAN_API_URL=http://localhost:8001

# The backend must trust the X-Forwarded-For header this app sends, so its
# rate limits apply per patient rather than to the whole Next.js server:
# set TRUST_PROXY_HEADERS=true in the backend, and keep the backend reachable
# only from this app (not from the internet).

# How many proxies you run in front of this app (load balancer, nginx, ...).
# The client address sent to the backend is the X-Forwarded-For entry this
# many places from the right; anything further left is client-controlled.
# Do not expose this app directly to the internet without such a proxy.
TRUSTED_PROXY_HOPS=1
